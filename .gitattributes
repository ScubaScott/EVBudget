# One rule for every computer: text files are stored with Unix (LF) line endings and checked out that way on
# Windows, macOS and Linux. Python, JavaScript, HTML and the shell scripts all read LF fine on Windows.
* text=auto eol=lf

# Windows batch files need CRLF to run reliably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.png binary
*.ico binary
*.icns binary
*.pdf binary
*.db binary
*.sqlite binary
